# Server Port
PORT=5000

# PostgreSQL Connection String (Standard URL format)
# Local: postgresql://username:password@localhost:5432/spinwheel_db
# Docker: postgresql://postgres:postgres@postgres:5432/spinwheel_db
# Render: postgresql://user:password@hostname/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spinwheel_db

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional individual PostgreSQL parameters (fallback if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spinwheel_db
